#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" || -z "${DIGITALOCEAN_SPACES_ENDPOINT:-}" ]]; then
    echo "DigitalOcean Spaces credentials are not configured; skipping symbol upload."
    exit 0
fi

if ! command -v aws >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command "choco install awscli -y"
fi

aws s3 cp symbols-lower s3://dev-openrct2/awesome/symbols/ \
    --recursive \
    --acl public-read \
    --endpoint-url "$DIGITALOCEAN_SPACES_ENDPOINT" \
    --region "${DIGITALOCEAN_SPACES_REGION:-us-east-1}" \
    --only-show-errors

echo "Uploaded symbol-server payload to s3://dev-openrct2/awesome/symbols/"
