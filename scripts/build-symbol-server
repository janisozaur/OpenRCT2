#!/usr/bin/env bash

set -euo pipefail

symstore_path='C:/Program Files (x86)/Windows Kits/10/Debuggers/x64/symstore.exe'
upload_root='symbols-upload'

run_windows_tool() {
    local tool="$1"
    shift
    MSYS2_ARG_CONV_EXCL='*' "$tool" "$@"
}

to_windows_path() {
    local path="$1"
    local absolute_path="$path"
    if [[ "$absolute_path" != /* ]]; then
        absolute_path="$PWD/$absolute_path"
    fi
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -aw "$absolute_path"
    else
        printf '%s\n' "$absolute_path"
    fi
}

# Download pdbconv and generate a compressed MSFZ symbol-server tree for the PDB.
curl -fL --retry 3 -o pdbconv.exe \
    https://github.com/janisozaur/pdbconv/releases/download/v1.0.0/pdbconv-windows-latest-msvc-x64.exe
rm -rf symbols "$upload_root"
./pdbconv.exe -i bin/openrct2-win.pdb -y -o symbols -c -s=SingleFragment -l=19

if [[ ! -f "$symstore_path" ]]; then
    echo "Required x64 symstore was not found: $symstore_path"
    exit 1
fi

makecab_path="$(command -v makecab.exe 2>/dev/null || command -v makecab 2>/dev/null || true)"
if [[ -z "$makecab_path" ]]; then
    echo 'makecab was not found on PATH.'
    exit 1
fi

symstore_input_path="$(to_windows_path bin/openrct2.exe)"
symstore_store_path="$(to_windows_path symbols)"

echo "Using symstore at: $symstore_path"
run_windows_tool "$symstore_path" add /f "$symstore_input_path" /s "$symstore_store_path" /t OpenRCT2

if [[ ! -d symbols/openrct2.exe ]]; then
    echo 'symstore did not create an openrct2.exe symbol-store directory.'
    exit 1
fi

exe_symstore_dir="$(find symbols/openrct2.exe -mindepth 1 -maxdepth 1 -type d | sort | head -1)"
if [[ -z "$exe_symstore_dir" ]]; then
    echo 'symstore did not create an openrct2.exe symbol-store entry.'
    exit 1
fi

exe_symstore_id="$(basename "$exe_symstore_dir")"
exe_symstore_file="$exe_symstore_dir/openrct2.exe"
if [[ ! -f "$exe_symstore_file" ]]; then
    echo "symstore did not create the expected EXE entry: $exe_symstore_file"
    exit 1
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT
compressed_exe_temp="$temp_dir/openrct2.ex_"
compressed_exe_temp_win="$(to_windows_path "$compressed_exe_temp")"

echo "Creating cabinet-compressed EXE with makecab: $makecab_path"
run_windows_tool "$makecab_path" /D CompressionType=LZX /D CompressionMemory=21 "$symstore_input_path" "$compressed_exe_temp_win"

compressed_exe_dir="symbols/openrct2.ex_/$exe_symstore_id"
compressed_exe_file="$compressed_exe_dir/openrct2.ex_"
mkdir -p "$compressed_exe_dir"
mv "$compressed_exe_temp" "$compressed_exe_file"

if [[ ! -d symbols/openrct2-win.pdb ]]; then
    echo 'pdbconv did not create the expected openrct2-win.pdb symbol-store entry.'
    exit 1
fi

mkdir -p "$upload_root"
cp -R symbols/openrct2-win.pdb "$upload_root/"
cp -R symbols/openrct2.ex_ "$upload_root/"

echo 'Symbol upload payload:'
find "$upload_root" -type f | sort
