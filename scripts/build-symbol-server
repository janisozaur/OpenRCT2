#!/usr/bin/env bash

set -euo pipefail

# Download pdbconv and generate a compressed MSFZ symbol-server tree for the PDB.
curl -fL --retry 3 -o pdbconv.exe \
    https://github.com/janisozaur/pdbconv/releases/download/v1.0.0/pdbconv-windows-latest-msvc-x64.exe
./pdbconv.exe -i bin/openrct2-win.pdb -y -o symbols -c -s=SingleFragment -l=19

# Use symstore to add openrct2.exe (plain and cabinet-compressed) so the EXE
# identity path follows Microsoft symbol server conventions.
symstore_path=""
symstore_candidates=()
symstore_root="C:/Program Files (x86)/Windows Kits"

add_symstore_candidate() {
    local candidate="$1"
    [[ -z "$candidate" ]] && return
    for existing in "${symstore_candidates[@]}"; do
        if [[ "$existing" == "$candidate" ]]; then
            return
        fi
    done
    symstore_candidates+=("$candidate")
}

probe_symstore_candidate() {
    local candidate="$1"
    "$candidate" /? >/dev/null 2>&1 && return 0
    "$candidate" -? >/dev/null 2>&1 && return 0
    "$candidate" /help >/dev/null 2>&1 && return 0
    return 1
}

# Detect runner architecture and prefer matching debugger tools.
host_arch="$(uname -m | tr '[:upper:]' '[:lower:]')"
native_debugger_arch=""
case "$host_arch" in
    x86_64|amd64)
        native_debugger_arch="x64"
        ;;
    i386|i686|x86)
        native_debugger_arch="x86"
        ;;
    aarch64|arm64)
        native_debugger_arch="arm64"
        ;;
    arm|armv7l|armv8l)
        native_debugger_arch="arm"
        ;;
esac

search_arches=()
if [[ -n "$native_debugger_arch" ]]; then
    search_arches+=("$native_debugger_arch")
fi
for arch in x64 x86 arm64 arm; do
    if [[ "$arch" != "$native_debugger_arch" ]]; then
        search_arches+=("$arch")
    fi
done

if [[ -d "$symstore_root" ]]; then
    for arch in "${search_arches[@]}"; do
        while IFS= read -r candidate; do
            add_symstore_candidate "$candidate"
        done < <(find "$symstore_root" -type f -path "*/Debuggers/$arch/symstore.exe" 2>/dev/null | sort -Vr)
    done
fi

# Also consider PATH entries, including native names.
for tool_name in symstore symstore.exe; do
    if command -v "$tool_name" >/dev/null 2>&1; then
        while IFS= read -r candidate; do
            add_symstore_candidate "$candidate"
        done < <(which -a "$tool_name" 2>/dev/null | awk '!seen[$0]++')
        add_symstore_candidate "$(command -v "$tool_name")"
    fi
done

echo "Discovered symstore candidates:"
if [[ "${#symstore_candidates[@]}" -eq 0 ]]; then
    echo "  (none)"
else
    for candidate in "${symstore_candidates[@]}"; do
        echo "  - $candidate"
    done
fi

for candidate in "${symstore_candidates[@]}"; do
    if probe_symstore_candidate "$candidate"; then
        symstore_path="$candidate"
        break
    fi
done

if [[ -z "$symstore_path" ]]; then
    echo "No runnable symstore found on runner; skipping openrct2.exe/openrct2.ex_ entries."
else
    echo "Using symstore at: $symstore_path"
    "$symstore_path" add /f bin/openrct2.exe /s symbols /t OpenRCT2
    "$symstore_path" add /f bin/openrct2.exe /s symbols /t OpenRCT2 /compress
    echo symbols:
    find symbols -type f | sort
fi

# Produce a fully-lowercase copy of the symbol tree; downstream tooling expects lowercase paths.
rm -rf symbols-lower
find symbols -mindepth 1 | while IFS= read -r src; do
    dst="symbols-lower/$(echo "${src#symbols/}" | tr '[:upper:]' '[:lower:]')"
    if [[ -d "$src" ]]; then
        mkdir -p "$dst"
    else
        mkdir -p "$(dirname "$dst")"
        cp "$src" "$dst"
    fi
done
