#!/usr/bin/env bash

set -euo pipefail

symstore_path='C:/Program Files (x86)/Windows Kits/10/Debuggers/x64/symstore.exe'
upload_root='symbols-upload'

# This is needed to prevent MSYS2 from converting arguments to Windows tools, which would break symstore.exe.
run_windows_tool() {
    local tool="$1"
    shift
    MSYS2_ARG_CONV_EXCL='*' "$tool" "$@"
}

to_windows_path() {
    local path="$1"
    local absolute_path="$path"
    if [[ "$absolute_path" != /* ]]; then
        absolute_path="$PWD/$absolute_path"
    fi
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -aw "$absolute_path"
    else
        printf '%s\n' "$absolute_path"
    fi
}

# Download pdbconv and generate a compressed MSFZ symbol-server tree for the PDB.
curl -fL --retry 3 -o pdbconv.exe \
    https://github.com/janisozaur/pdbconv/releases/download/v1.0.0/pdbconv-windows-latest-msvc-x64.exe
rm -rf "$upload_root"
mkdir -p "$upload_root"
./pdbconv.exe -i bin/openrct2-win.pdb -y -o "$upload_root" -c -s=SingleFragment -l=19

if [[ ! -f "$symstore_path" ]]; then
    echo "Required x64 symstore was not found: $symstore_path"
    exit 1
fi

# Use symstore directly with /compress so we produce openrct2.ex_ in symbol-store layout.
symstore_input_path="$(to_windows_path bin/openrct2.exe)"
symstore_store_path="$(to_windows_path "$upload_root")"

echo "Using symstore at: $symstore_path"
run_windows_tool "$symstore_path" add /f "$symstore_input_path" /s "$symstore_store_path" /t OpenRCT2 /compress

if [[ ! -d "$upload_root/openrct2.exe" ]]; then
    echo 'symstore did not create an openrct2.exe symbol-store directory.'
    exit 1
fi

exe_symstore_dir="$(find "$upload_root/openrct2.exe" -mindepth 1 -maxdepth 1 -type d | sort | head -1)"
if [[ -z "$exe_symstore_dir" ]]; then
    echo 'symstore did not create an openrct2.exe symbol-store entry.'
    exit 1
fi

exe_symstore_id="$(basename "$exe_symstore_dir")"
compressed_exe_file="$exe_symstore_dir/openrct2.ex_"
if [[ ! -f "$compressed_exe_file" ]]; then
    echo "symstore did not create the expected compressed EXE entry: $compressed_exe_file"
    exit 1
fi

if [[ ! -d "$upload_root/openrct2-win.pdb" ]]; then
    echo 'pdbconv did not create the expected openrct2-win.pdb symbol-store entry.'
    exit 1
fi

# Keep only publishable symbol payload; drop symstore transaction metadata files.
find "$upload_root" -mindepth 1 -maxdepth 1 \
    ! -name 'openrct2-win.pdb' \
    ! -name 'openrct2.exe' \
    -exec rm -rf {} +

# Add cross-references between the symstore and pdbconv outputs, so that the EXE and PDB entries can be linked together in the symbol server.
pdb_symstore_dir="$(find "$upload_root/openrct2-win.pdb" -mindepth 1 -maxdepth 1 -type d | sort | head -1)"
if [[ -z "$pdb_symstore_dir" ]]; then
    echo 'pdbconv did not create an openrct2-win.pdb symbol-store entry.'
    exit 1
fi

pdb_symstore_id="$(basename "$pdb_symstore_dir")"

# Gather metadata for symbol entries
git_commit="$(git rev-parse HEAD)"
git_tag="$(git describe --tags --exact-match 2>/dev/null || echo "")"

# Construct GitHub Actions run link if running in CI
if [[ -n "${GITHUB_RUN_ID:-}" ]]; then
    github_actions_run="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
else
    github_actions_run="local"
fi

# Get target architecture (from CI matrix, or default to x64)
architecture="${PLATFORM:-x64}"

# Calculate SHA256 checksums of the symbol files
exe_sha256="$(sha256sum "$compressed_exe_file" | awk '{print $1}')"
pdb_sha256="$(sha256sum "$pdb_symstore_dir/openrct2-win.pdb" | awk '{print $1}')"

# Helper function to write info file with cross-references and metadata
write_info_file() {
    local dir="$1"
    local sha_field="$2"
    local sha_value="$3"

    {
        echo "exe_symstore_id: $exe_symstore_id"
        echo "pdb_symstore_id: $pdb_symstore_id"
        echo "git_commit: $git_commit"
        [[ -n "$git_tag" ]] && echo "git_tag: $git_tag"
        echo "github_actions_run: $github_actions_run"
        echo "architecture: $architecture"
        echo "$sha_field: $sha_value"
    } > "$dir/info"
}

write_info_file "$pdb_symstore_dir" "sha256_pdb" "$pdb_sha256"
write_info_file "$exe_symstore_dir" "sha256_exe" "$exe_sha256"

echo 'Symbol upload payload:'
find "$upload_root" -type f | sort
